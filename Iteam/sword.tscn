[sub_resource type="GDScript" id="GDScript_v8qqo"]
resource_name = "sword"
script/source = "extends RigidBody3D

@onready var ray_cast_hit: RayCast3D = $s/RayCast3D

@onready var get_player = get_tree().get_first_node_in_group(\"PR\")
var player

func _ready() -> void:
	var sword = [$\"s/Weapons for Itch with image texture_fbx_Great_Sword\",
	 $\"s/Weapons for Itch with image texture_fbx_Kriegmesser\"].pick_random()
	sword.show()
	player = get_player


func pp():
	Items.add_item_to_inventory(\"sword\", 1)
	queue_free()

func fz():
	freeze = true
	$CollisionShape3D.set_deferred(\"disabled\", true)
	
func att():
	var anim = [\"att\", \"att2\", \"att3\"].pick_random()
	if ! $AnimationPlayer.is_playing():
		$AnimationPlayer.play(anim)
	$s/GPUTrail3D.show()
	await $AnimationPlayer.animation_finished
	
	if player.is_in_group(\"PR\"):
		if player.has_method(\"camera_shaking\"):
			player.camera_shaking(0.2)
	$s/GPUTrail3D.hide()
	ray_cast_hit.force_raycast_update()
	if ray_cast_hit.is_colliding():
		var ray = ray_cast_hit.get_collider()
		var rry = ray
		if rry.is_in_group(\"stone\") or rry.is_in_group(\"tree\"):
			if rry.has_method(\"take_damage\"):
				rry.take_damage(2)
				
"

