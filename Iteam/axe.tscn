[gd_scene format=3 uid="uid://ihad8w7cjl8c"]

[ext_resource type="ArrayMesh" uid="uid://c01joy40hhxvq" path="res://3d_modle/axe.res" id="1_3mk3t"]

[sub_resource type="GDScript" id="GDScript_3mk3t"]
resource_name = "axe"
script/source = "extends RigidBody3D

@onready var get_player = get_tree().get_first_node_in_group(\"PR\")
var player

func _ready() -> void:
	player = get_player

func pp():
	Items.add_item_to_inventory(\"axe\", 1)
	queue_free()
	
	
func fz():
	freeze = true
	$CollisionShape3D.set_deferred(\"disabled\", true)
	
func att():
	var anim = [\"attck\" ,\"attck2\",\"attck3\"]
	var play = anim.pick_random()
	if ! $AnimationPlayer.is_playing():
		$AnimationPlayer.play(play)
		await $AnimationPlayer.animation_finished
		
		if player.is_in_group(\"PR\"):
			if player.has_method(\"camera_shaking\"):
				player.camera_shaking(0.1)
		$Axe/RayCast3D.force_raycast_update()
		if $Axe/RayCast3D.is_colliding():
			var rr = $Axe/RayCast3D.get_collider()
			if rr.is_in_group(\"tree\"):
				if rr.has_method(\"take_damage\"):
					rr.take_damage(20)
"

